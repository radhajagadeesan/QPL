(executable
 (name source_typecheck_harness)
 (modules source_typecheck_harness)
 (libraries unix qpl_surface))

(rule
 (alias runtest)
 (deps
  (sandbox always)
  (package qpl_surface)
  (source_tree source_conformance))
 (action
  (run %{exe:source_typecheck_harness.exe}
       --ocamlc %{ocamlc}
       --public-cmi %{lib:qpl_surface:qpl_surface.cmi}
       --fixtures source_conformance)))

