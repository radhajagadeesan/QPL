(* ================================================================== *)
(* QPL Surface Language - Algorithmic Snippets                        *)
(* ================================================================== *)
(*
   Notes:
   - (+) is monoidal (not a coproduct)
   - All higher-order constructs elaborate away
   - Unitary atoms are opaque primitives
*)

(* ================================================================== *)
(* Common Datatypes                                                   *)
(* ================================================================== *)

datatype Unit = U of I

datatype Bit = Zero of I | One of I

datatype Bool['a, 'b] = F of 'a | T of 'b

(* ================================================================== *)
(* Snippet 6.1: Deutsch-Jozsa                                         *)
(* ================================================================== *)

(* Assumed atoms:
   unitary atom H     : Q → Q
   unitary atom Hn    : QReg[n] → QReg[n]
   unitary atom Uf    : (QReg[n] ⊗ Q) → (QReg[n] ⊗ Q)
   unitary atom ket0n : I → QReg[n]
   unitary atom ket1  : I → Q
*)

def deutschJozsa[n] : I → (QReg[n] ⊗ Q) =
  λu.
    let x  = Hn (ket0n u) in
    let y  = H  (ket1  u) in
    let (x1, y1) = Uf (x ⊗ y) in
    let x2 = Hn x1 in
    (x2 ⊗ y1)

(* ================================================================== *)
(* Snippet 6.2: Hidden Subgroup Problem (Standard Oracle)             *)
(* ================================================================== *)

(* Assumed atoms:
   unitary atom uniformG : I → G
   unitary atom zeroX    : I → X
   unitary atom Uf       : (G ⊗ X) → (G ⊗ X)
   unitary atom QFTG     : G → G
*)

def HSP_core : I → (G ⊗ X) =
  λu.
    let g  = uniformG u in
    let x  = zeroX    u in
    let (g1, x1) = Uf (g ⊗ x) in
    let g2 = QFTG g1 in
    (g2 ⊗ x1)

(* ================================================================== *)
(* Snippet 6.3: Hidden Subgroup Problem (Phase-Kickback)              *)
(* ================================================================== *)

(* Assumed atoms:
   unitary atom uniformG : I → G
   unitary atom chiZN    : I → ZN
   unitary atom kick     : (G ⊗ ZN) → (G ⊗ ZN)
   unitary atom QFTG     : G → G
*)

def HSP_phase : I → G =
  λu.
    let g  = uniformG u in
    let z  = chiZN    u in
    let (g1, _z1) = kick (g ⊗ z) in
    let g2 = QFTG g1 in
    g2

(* ================================================================== *)
(* Snippet 6.4: Simon's Algorithm                                     *)
(* ================================================================== *)

(* Assumed atoms:
   unitary atom uniformZ2n : I → Z2n[n]
   unitary atom zeroY      : I → Y
   unitary atom Uf         : (Z2n[n] ⊗ Y) → (Z2n[n] ⊗ Y)
   unitary atom QFT2n      : Z2n[n] → Z2n[n]
*)

def Simon_core[n] : I → (Z2n[n] ⊗ Y) =
  λu.
    let x = uniformZ2n u in
    let y = zeroY      u in
    let (x1, y1) = Uf (x ⊗ y) in
    let x2 = QFT2n x1 in
    (x2 ⊗ y1)

(* ================================================================== *)
(* Concrete Examples (Q-typed)                                        *)
(* ================================================================== *)

(* Bell state preparation: |00⟩ → (|00⟩ + |11⟩)/√2 *)
def bellState : (Q ⊗ Q) → (Q ⊗ Q) =
  H[0] ; CX[0,1]

(* GHZ state preparation: |000⟩ → (|000⟩ + |111⟩)/√2 *)
def ghzState : (Q ⊗ Q ⊗ Q) → (Q ⊗ Q ⊗ Q) =
  H[0] ; CX[0,1] ; CX[0,2]

(* Two-qubit circuit example *)
def twoQubitCircuit : (Q ⊗ Q) → (Q ⊗ Q) =
  H[0] ; CX[0,1] ; H[0]

(* ================================================================== *)
(* Structural Examples (Using Datatypes)                              *)
(* ================================================================== *)

(* Swap via case expression - elaborates to TwistPlus *)
def swap : Bool['a, 'b] → Bool['b, 'a] =
  λx. case x of
    | F(a) => T(a)
    | T(b) => F(b)

(* Identity via case - elaborates to Id *)
def boolId : Bool['a, 'b] → Bool['a, 'b] =
  λx. case x of
    | F(a) => F(a)
    | T(b) => T(b)

(* Involution example: swap ∘ swap = id *)
def swapTwice : Bool['a, 'b] → Bool['a, 'b] =
  swap ; swap

(* Exponential of involution *)
def phaseSwap : Bool['a, 'b] → Bool['a, 'b] =
  exp_i(π/7, swap)

(* ================================================================== *)
(* Triple Datatype (3 constructors)                                   *)
(* ================================================================== *)

datatype Triple['a, 'b, 'c] = A of 'a | B of 'b | C of 'c

(* Rotation: A→B, B→C, C→A *)
def rotate : Triple['a, 'b, 'c] → Triple['c, 'a, 'b] =
  λx. case x of
    | A(a) => B(a)
    | B(b) => C(b)
    | C(c) => A(c)

(* Swap first two: A↔B, C→C *)
def swapAB : Triple['a, 'b, 'c] → Triple['b, 'a, 'c] =
  λx. case x of
    | A(a) => B(a)
    | B(b) => A(b)
    | C(c) => C(c)
